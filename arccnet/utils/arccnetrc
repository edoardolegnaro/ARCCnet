;
; ARCCnet Configuration
;

;;;;;;;;;;;;;;;;;;;
; General Options ;
;;;;;;;;;;;;;;;;;;;
[general]
start_date = 1995-01-01T00:00:00
end_date = 2022-12-31T00:00:00
merge_tolerance = 30m

;;;;;;;;;;;;;;;;;
; JSOC specific ;
;;;;;;;;;;;;;;;;;
[jsoc]
jsoc_date_format = %Y.%m.%d_%H:%M:%S
jsoc_base_url = http://jsoc.stanford.edu

[drms]
rep_tol = 60
sample = 60
hmi_keys = T_REC, T_OBS, QUALITY, *recnum*, WAVELNTH, INSTRUME
aia_keys = T_REC, T_OBS, QUALITY, FSN, WAVELNTH, INSTRUME
wavelengths = 171, 193, 304, 211, 335, 94, 131
patch_height = 400
patch_width = 800
cores = 4
; Email registered with JSOC for DRMS exports (http://jsoc.stanford.edu/ajax/register_email.html).
; Leave blank to read JSOC_EMAIL from the environment at runtime, or override
; this value in a user arccnetrc.
jsoc_email =
; Number of retries when patching bad-quality records.
quality_retries = 3
; Maximum concurrent DRMS query/export sessions.
max_drms_connections = 6
; Records prefetched by download threads while the current record is processed.
; Each in-flight record holds ~60 full-disk maps (~2 GB) in memory.
download_workers = 3

[timeseries]
; Observation window length in hours (one frame per hour).
duration_hours = 6
; Number of frames per sample (hourly cadence over duration_hours).
timesteps = 6
; Longitudinal limit (degrees from central meridian) for accepted ARs.
long_lim_degrees = 65
; Year range of SRS records used to build target runs (inclusive).
; Covers the full span with both SDO data and flare-catalogue coverage.
year_start = 2010
year_end = 2022
; First date with AIA and HMI science data; SRS records before this are skipped.
sdo_start_date = 2010-05-13
; End of flare-catalogue coverage. Samples whose 24 h label window extends
; past this date are dropped (their labels would be silently truncated).
catalog_end_date = 2023-01-01
; Catalogue files, relative to {data_folder}/flare_files.
hek_file = hek_swpc_1996-01-01T00:00:00-2023-01-01T00:00:00_dev.parq
srs_file = srs_processed_catalog.parq
; Keep AR-day samples with no C+ flare in the following 24 h (negatives).
; Must be true to produce a climatologically representative dataset.
keep_no_flare = True
; Samples per year (-1 = all).
samples_per_year = -1
; Correct AIA images for time-dependent instrument degradation (aiapy).
; Required for radiometric consistency across the mission; without it the
; acquisition epoch is imprinted on image intensities.
aia_degradation_correction = True
; Skip samples whose 04_final output already exists (safe restart of long runs).
resume = True
; Render the per-sample mosaic animation (slow; disable for bulk generation).
make_animations = False


;;;;;;;;;;;;;;;;
; SRS          ;
;;;;;;;;;;;;;;;;
[srs]
lat_lim_degrees = 60
lon_lim_degrees = 85

;;;;;;;;;;;;;;;;
; Magnetograms ;
;;;;;;;;;;;;;;;;
[magnetograms]
problematic_quicklooks = 20010116_000028_MDI.png, \
    20001130_000028_MDI.png, \
    19990420_235943_MDI.png, \
    19960904_000030_.png, \
    19960905_000030_.png, \
    20010116_000028_.png, \
    20001130_000028_.png, \
    19990420_235943_.png, \
    19960916_000030_.png, \
    19960903_000030_.png, \
    20050201_235943_.png, \
    20090527_000026_.png


[magnetograms.cutouts]
x_extent = 800
y_extent = 400

;;;;;;;;;
; Paths ;
;;;;;;;;;
[paths]
data_folder = ${ARCAFF_DATA_FOLDER}

data_dir_raw = ${data_root}/01_raw
data_dir_intermediate = ${data_root}/02_intermediate
data_dir_processed = ${data_root}/03_processed
data_dir_final = ${data_root}/04_final

data_dir_logs = ${data_root}/logs
data_logfile = ${data_dir_logs}/data_processing_

;;;;;;;;;;;;
; Logger   ;
;;;;;;;;;;;;
[logger]

# Threshold for the logging messages. Logging messages that are less severe
# than this level will be ignored. The levels are 'DEBUG', 'INFO', 'WARNING',
# 'ERROR'
log_level = INFO

# Whether to use color for the level names
use_color = True

# Whether to log warnings.warn calls
log_warnings = True

# Whether to log exceptions before raising them
log_exceptions = False

# Whether to always log messages to a log file
log_to_file = False

# The file to log messages to
# log_file_path = arccnet.log

# Threshold for logging messages to log_file_path
log_file_level = INFO

# Format for log file entries
log_file_format = %(asctime)s, %(origin)s, %(levelname)s, %(message)s
